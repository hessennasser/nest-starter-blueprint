{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": false,
    "assets": [
      { "include": "i18n/**/*", "outDir": "dist" },
      { "include": "shared/mail/templates/**/*.hbs", "outDir": "dist" }
    ],
    "watchAssets": true
  }
}
